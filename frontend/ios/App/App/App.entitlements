<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- "production", not "development" — this build is signed with the
	     Apple Distribution certificate + "Daawatey App Store" provisioning
	     profile (see ios-release-build.yml), which only grants the
	     production APNs environment. The APNs Auth Key uploaded to Firebase
	     (2026-09-28) is scoped to both Sandbox & Production, so it works
	     with whichever environment the binary actually declares here. -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<!-- The app never uses Game Center — this exists only because App
	     Store Connect refused "Add for Review" with "You must add the
	     com.apple.developer.game-center key in Xcode", despite Game
	     Center being off both in App Store Connect's own Game Center page
	     (nothing configured) and in the App ID's capability list. This is
	     a documented false positive: GoogleAppMeasurement (part of
	     Firebase Analytics, pulled in transitively by
	     @capacitor-firebase/authentication) weakly links GameKit.framework
	     for optional game-analytics events it never fires here, and
	     App Store Connect's validator flags that link as "wants Game
	     Center" regardless of whether it's actually used. Declaring the
	     entitlement satisfies the check without building any Game Center
	     feature. -->
	<key>com.apple.developer.game-center</key>
	<true/>
</dict>
</plist>
