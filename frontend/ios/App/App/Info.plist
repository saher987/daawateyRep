<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>daawatey</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Skips App Store Connect's export-compliance question on every
	     submission: this app only uses standard HTTPS/TLS (Firebase Auth,
	     the Cloud Run backend, Firebase Storage) — no custom/proprietary
	     encryption — which is exactly the exemption this key declares. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- @capacitor-firebase/authentication bundles the Facebook SDK as one
	     of its supported providers (FBSDKCoreKit/FBSDKLoginKit/FBAEMKit) —
	     confirmed linked into the app binary even though this app never
	     calls any Facebook Login API. These placeholder values silence
	     FBSDKCoreKit's own startup validation without ever being used for
	     anything real, and auto-logging/tracking is explicitly disabled
	     since Facebook Login itself is never invoked.

	     NOTE: these keys were originally added as a hypothesis for the
	     TestFlight launch crash (build 9: SIGABRT/objc_exception_throw
	     during -[UIWindow _mainQueue_makeKeyAndVisible]). That hypothesis
	     was disproven — build 10 shipped with these keys and crashed at
	     byte-identical offsets. Symbolicating build 10's crash via its
	     dSYM found the real cause: GoogleService-Info.plist was written to
	     disk by CI but never referenced in App.xcodeproj's Resources build
	     phase, so it was missing from the shipped bundle, and the
	     Capacitor Firebase Authentication plugin's `load()` calls
	     `+[FIRApp configure]`, which throws when that file is absent. Fixed
	     in App.xcodeproj/project.pbxproj (see ios-release-build.yml). These
	     Facebook keys are kept because they're still correct/harmless, not
	     because they were the fix. -->
	<key>FacebookAppID</key>
	<string>0000000000000000</string>
	<key>FacebookClientToken</key>
	<string>0000000000000000000000000000000</string>
	<key>FacebookDisplayName</key>
	<string>daawatey</string>
	<key>FacebookAutoLogAppEventsEnabled</key>
	<false/>
	<key>FacebookAdvertiserIDCollectionEnabled</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
