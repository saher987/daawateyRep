# Copy to .env.staging or .env.production and fill in with values from
# Firebase Console → Project settings → Your apps → web app config.
# These values are not secret (they ship in the frontend bundle) but are
# still kept out of git since they're per-environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend base URL. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

# Test-only email/password sign-in path (simulators/device farms can't run a
# real Google/Apple picker). Harmless to leave "true" on web today; this flag
# starts mattering once Capacitor native builds exist — prod native builds
# must set it to "false".
VITE_ALLOW_EMAIL_AUTH=true
