server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Vite content-hashes every file under /assets — a given filename's
    # content never changes, so it's always safe to cache aggressively.
    # index.html is the opposite: its filename never changes, but which
    # hashed asset files it references does, on every deploy. Without this
    # split, a browser that cached index.html from a previous deploy keeps
    # requesting that old deploy's now-deleted asset filenames — Cloud Run
    # only ever serves the current image's files, so the request 404s,
    # nginx's SPA fallback below serves index.html's HTML for it, and the
    # browser refuses to run HTML as the JS module it asked for. This bit
    # us on the very first real deploy after adding new lazy-loaded pages.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
